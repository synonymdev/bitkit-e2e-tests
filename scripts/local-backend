#!/usr/bin/env bash
# Pinned regtest fixtures for Appium.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cache="$root/.cache/local-backend"
stack="${BITKIT_LOCAL_BACKEND_ROOT:-$cache/infra}"
credentials="$cache/lnd"
revision="$(tr -d '[:space:]' < "$root/BITKIT_DOCKER_REVISION")"

if [[ ! "$revision" =~ ^[0-9a-f]{40}$ ]]; then
  echo 'BITKIT_DOCKER_REVISION must contain a full Git SHA.' >&2
  exit 1
fi

check_revision() {
  local actual
  actual="$(git -C "$stack" rev-parse --verify HEAD 2>/dev/null || true)"
  if [[ "$actual" != "$revision" ]]; then
    echo "Expected bitkit-docker $revision at $stack. Run ./scripts/local-backend prepare." >&2
    exit 1
  fi
  if ! git -C "$stack" diff --quiet HEAD --; then
    echo "The pinned bitkit-docker checkout has local source edits: $stack" >&2
    exit 1
  fi
}

prepare() {
  if [[ -z "${BITKIT_LOCAL_BACKEND_ROOT:-}" ]]; then
    if [[ ! -e "$stack/.git" ]]; then
      mkdir -p "$stack"
      git -C "$stack" init >&2
      git -C "$stack" remote add origin https://github.com/synonymdev/bitkit-docker.git
    fi
    if [[ "$(git -C "$stack" rev-parse --verify HEAD 2>/dev/null || true)" != "$revision" ]]; then
      if ! git -C "$stack" diff --quiet HEAD -- 2>/dev/null && git -C "$stack" rev-parse --verify HEAD >/dev/null 2>&1; then
        echo "The cached bitkit-docker checkout has local source edits: $stack" >&2
        exit 1
      fi
      git -C "$stack" fetch --depth 1 origin "$revision" >&2
      git -C "$stack" checkout --detach "$revision" >&2
    fi
  fi
  check_revision
  echo "Using bitkit-docker $revision" >&2
}

compose() (
  cd "$stack"
  docker compose "$@"
)

spark() (
  cd "$stack"
  ./spark "$@"
)

spark_up() {
  prepare
  local SPARK_PUBLIC_HOST=127.0.0.1
  export SPARK_PUBLIC_HOST
  local services service
  local spark_services=()
  services="$(compose --profile spark config --services)"
  while IFS= read -r service; do
    if [[ "$service" == spark-* ]]; then spark_services+=("$service"); fi
  done <<< "$services"
  compose --profile spark up -d --build --no-recreate bitcoind bitcoinsetup electrs "${spark_services[@]}"
  local status=0
  compose --profile spark wait spark-ready || status=$?
  compose --profile spark logs --no-log-prefix spark-ready
  return "$status"
}

spark_env() {
  check_revision
  local config
  config="$(spark config --base64)"
  [[ -n "$config" ]] || { echo 'Local Spark config is empty.' >&2; return 1; }
  printf 'SPARK_LOCAL_CONFIG_B64=%s\n' "$config"
  printf 'SPARK_LOCAL_CHAIN_URL=http://127.0.0.1:23090/api\n'
}

set_runner_env() {
  export BITKIT_LOCAL_BACKEND_ROOT="$stack"
  export ELECTRUM_PORT="${ELECTRUM_PORT:-60001}"
  export LND_P2P_PORT="${LND_P2P_PORT:-23735}"
  export LND_GRPC_PORT="${LND_GRPC_PORT:-23009}"
  export LND_REST_PORT="${LND_REST_PORT:-23180}"
  export LND_TLS_PATH="$credentials/tls.cert"
  export LND_MACAROON_PATH="$credentials/admin.macaroon"
}

up() {
  prepare
  compose up -d bitcoind bitcoinsetup electrs darkhttpd lnd ldk-backup-server
  compose wait bitcoinsetup

  local attempt
  mkdir -p "$credentials"
  for ((attempt = 0; attempt < 60; attempt++)); do
    if nc -z 127.0.0.1 "${ELECTRUM_PORT:-60001}" 2>/dev/null &&
      compose cp lnd:/home/lnd/.lnd/tls.cert "$credentials/tls.cert" >/dev/null 2>&1 &&
      compose cp lnd:/home/lnd/.lnd/data/chain/bitcoin/regtest/admin.macaroon "$credentials/admin.macaroon" >/dev/null 2>&1 &&
      [[ -s "$credentials/tls.cert" && -s "$credentials/admin.macaroon" ]]; then
      local balance
      balance="$(compose exec -T bitcoind bitcoin-cli -rpcport=43782 -rpcuser=polaruser -rpcpassword=polarpass getbalance)"
      awk -v balance="$balance" 'BEGIN { exit !(balance > 0) }' || {
        echo 'The pinned regtest wallet has no spendable balance.' >&2
        return 1
      }
      echo "Pinned backend ready with $balance BTC of spendable regtest funds."
      return
    fi
    sleep 2
  done

  echo 'Timed out waiting for Electrum and LND credentials.' >&2
  compose ps >&2
  return 1
}

case "${1:-}" in
  prepare) prepare ;;
  path)
    check_revision
    printf '%s\n' "$stack"
    ;;
  up) up ;;
  spark-up) spark_up ;;
  spark-env) spark_env ;;
  spark-pay)
    check_revision
    [[ "${2:-}" =~ ^lnbcrt[a-z0-9]+$ && "$#" -eq 2 ]] || {
      echo 'Usage: ./scripts/local-backend spark-pay <regtest-invoice>' >&2
      exit 2
    }
    spark pay "$2"
    ;;
  spark-down|spark-logs)
    check_revision
    command="${1#spark-}"
    shift
    compose --profile spark "$command" "$@"
    ;;
  down|ps|logs)
    check_revision
    compose "$@"
    ;;
  github-env)
    check_revision
    set_runner_env
    for key in BITKIT_LOCAL_BACKEND_ROOT ELECTRUM_PORT LND_P2P_PORT LND_GRPC_PORT LND_REST_PORT LND_TLS_PATH LND_MACAROON_PATH; do
      printf '%s=%s\n' "$key" "${!key}"
    done
    ;;
  run)
    shift
    check_revision
    set_runner_env
    export BACKEND=local
    exec "$@"
    ;;
  *)
    echo 'Usage: ./scripts/local-backend {prepare|path|up|down|ps|logs|github-env|run <command>|spark-up|spark-env|spark-pay <invoice>|spark-down|spark-logs}' >&2
    exit 2
    ;;
esac
