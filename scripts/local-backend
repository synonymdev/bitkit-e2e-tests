#!/usr/bin/env bash
# Pinned regtest fixtures for Appium.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cache="$root/.cache/local-backend"
stack="${BITKIT_LOCAL_BACKEND_ROOT:-$cache/infra}"
credentials="$cache/lnd"
revision="$(tr -d '[:space:]' < "$root/BITKIT_DOCKER_REVISION")"
spark_base_services=(bitcoind bitcoinsetup electrs)

if [[ ! "$revision" =~ ^[0-9a-f]{40}$ ]]; then
  echo 'BITKIT_DOCKER_REVISION must contain a full Git SHA.' >&2
  exit 1
fi

check_revision() {
  local actual
  actual="$(git -C "$stack" rev-parse --verify HEAD 2>/dev/null || true)"
  if [[ "$actual" != "$revision" ]]; then
    echo "Expected bitkit-docker $revision at $stack. Run ./scripts/local-backend prepare." >&2
    exit 1
  fi
  if ! git -C "$stack" diff --quiet HEAD --; then
    echo "The pinned bitkit-docker checkout has local source edits: $stack" >&2
    exit 1
  fi
}

prepare() {
  if [[ -z "${BITKIT_LOCAL_BACKEND_ROOT:-}" ]]; then
    if [[ ! -e "$stack/.git" ]]; then
      mkdir -p "$stack"
      git -C "$stack" init >&2
      git -C "$stack" remote add origin https://github.com/synonymdev/bitkit-docker.git
    fi
    if [[ "$(git -C "$stack" rev-parse --verify HEAD 2>/dev/null || true)" != "$revision" ]]; then
      if ! git -C "$stack" diff --quiet HEAD -- 2>/dev/null && git -C "$stack" rev-parse --verify HEAD >/dev/null 2>&1; then
        echo "The cached bitkit-docker checkout has local source edits: $stack" >&2
        exit 1
      fi
      git -C "$stack" fetch --depth 1 origin "$revision" >&2
      git -C "$stack" checkout --detach "$revision" >&2
    fi
  fi
  check_revision
  echo "Using bitkit-docker $revision" >&2
}

compose() (
  cd "$stack"
  docker compose "$@"
)

spark() (
  cd "$stack"
  ./spark "$@"
)

spark_services() {
  compose --profile spark config --services | awk '/^spark-/'
}

spark_fixture_services() {
  printf '%s\n' "${spark_base_services[@]}"
  spark_services
}

spark_fixture_images() {
  compose --profile spark config --images "$@" | LC_ALL=C sort -u
}

spark_image_fingerprint() {
  local service_list service image_list image image_id
  local services=() image_ids=()
  service_list="$(spark_fixture_services)" || return
  while IFS= read -r service; do services+=("$service"); done <<< "$service_list"
  image_list="$(spark_fixture_images "${services[@]}")" || return
  while IFS= read -r image; do
    image_id="$(docker image inspect --format '{{.Id}}' "$image")" || return
    image_ids+=("$image $image_id")
  done <<< "$image_list"
  printf '%s\n' "${image_ids[@]}" | shasum -a 256 | awk '{print $1}'
}

spark_build() {
  # Some Spark services use the same tag. Select one target per image.
  local targets=(spark-so-0 spark-migrations-0 spark-ldk-server spark-sspd spark-ready spark-lnurl spark-data-sync)
  if [[ -z "${SPARK_IMAGE_CACHE:-}" ]]; then
    compose --profile spark build "${targets[@]}"
    return
  fi

  local definitions target image archive
  local images=()
  definitions="$(compose --profile spark config --format json)"
  for target in "${targets[@]}"; do
    image="$(jq -er --arg target "$target" '.services[$target].image | strings | select(length > 0)' <<< "$definitions")"
    images+=("$image")
  done

  if [[ -s "$SPARK_IMAGE_CACHE" ]] &&
    docker image load --input "$SPARK_IMAGE_CACHE" &&
    docker image inspect "${images[@]}" >/dev/null; then
    echo 'Loaded pinned Spark images from cache.'
    return
  fi

  compose --profile spark build "${targets[@]}"
  if archive="$(mktemp "${SPARK_IMAGE_CACHE}.XXXXXX")"; then
    if docker image save --output "$archive" "${images[@]}" && mv "$archive" "$SPARK_IMAGE_CACHE"; then
      echo 'Saved pinned Spark images for caching.'
      return
    fi
    rm -f "$archive"
  fi
  echo 'Could not save the Spark image cache. Continuing with the built images.' >&2
}

spark_pack() {
  local archive="$1"
  prepare
  local services service image_list image
  local targets=()
  local images=()
  services="$(spark_fixture_services)"
  while IFS= read -r service; do targets+=("$service"); done <<< "$services"

  SPARK_IMAGE_CACHE= spark_build
  compose --profile spark pull --ignore-buildable "${targets[@]}"
  image_list="$(spark_fixture_images "${targets[@]}")"
  while IFS= read -r image; do images+=("$image"); done <<< "$image_list"
  docker image save --output "$archive" "${images[@]}"
}

spark_up() {
  prepare
  local SPARK_PUBLIC_HOST=127.0.0.1
  export SPARK_PUBLIC_HOST
  local services service
  local profile_services=()
  local start_args=(-d)
  local base_args=(--no-recreate)
  services="$(spark_services)"
  while IFS= read -r service; do profile_services+=("$service"); done <<< "$services"
  if [[ -n "${SPARK_IMAGE_ARCHIVE:-}" ]]; then
    docker image load --input "$SPARK_IMAGE_ARCHIVE"
  fi
  if [[ -n "${SPARK_IMAGE_FINGERPRINT:-}" ]]; then
    if [[ "$(spark_image_fingerprint)" != "$SPARK_IMAGE_FINGERPRINT" ]]; then
      echo 'The local Docker images do not match the pinned Spark fixture archive.' >&2
      return 1
    fi
  fi
  if [[ -n "${SPARK_IMAGE_ARCHIVE:-}${SPARK_IMAGE_FINGERPRINT:-}" ]]; then
    start_args+=(--pull never)
    base_args+=(--no-build)
  fi
  compose up "${start_args[@]}" "${base_args[@]}" "${spark_base_services[@]}"
  if [[ -z "${SPARK_IMAGE_ARCHIVE:-}${SPARK_IMAGE_FINGERPRINT:-}" ]]; then spark_build; fi
  # Let Compose refresh Spark services when their advertised host changes.
  compose --profile spark up "${start_args[@]}" --no-build "${profile_services[@]}"
  local status=0
  compose --profile spark wait spark-ready || status=$?
  compose --profile spark logs --no-log-prefix spark-ready
  return "$status"
}

spark_env() {
  check_revision
  local config
  config="$(spark config --base64)"
  [[ -n "$config" ]] || { echo 'Local Spark config is empty.' >&2; return 1; }
  printf 'SPARK_LOCAL_CONFIG_B64=%s\n' "$config"
  printf 'SPARK_LOCAL_CHAIN_URL=http://127.0.0.1:23090/api\n'
}

spark_init_env() {
  prepare
  local SPARK_PUBLIC_HOST=127.0.0.1
  export SPARK_PUBLIC_HOST
  compose --profile spark up --no-deps --no-build --pull never --exit-code-from spark-init spark-init >&2
  spark_env
}

set_runner_env() {
  export BITKIT_LOCAL_BACKEND_ROOT="$stack"
  export ELECTRUM_PORT="${ELECTRUM_PORT:-60001}"
  export LND_P2P_PORT="${LND_P2P_PORT:-23735}"
  export LND_GRPC_PORT="${LND_GRPC_PORT:-23009}"
  export LND_REST_PORT="${LND_REST_PORT:-23180}"
  export LND_TLS_PATH="$credentials/tls.cert"
  export LND_MACAROON_PATH="$credentials/admin.macaroon"
}

up() {
  prepare
  compose up -d bitcoind bitcoinsetup electrs darkhttpd lnd ldk-backup-server
  compose wait bitcoinsetup

  local attempt
  mkdir -p "$credentials"
  for ((attempt = 0; attempt < 60; attempt++)); do
    if nc -z 127.0.0.1 "${ELECTRUM_PORT:-60001}" 2>/dev/null &&
      compose cp lnd:/home/lnd/.lnd/tls.cert "$credentials/tls.cert" >/dev/null 2>&1 &&
      compose cp lnd:/home/lnd/.lnd/data/chain/bitcoin/regtest/admin.macaroon "$credentials/admin.macaroon" >/dev/null 2>&1 &&
      [[ -s "$credentials/tls.cert" && -s "$credentials/admin.macaroon" ]]; then
      local balance
      balance="$(compose exec -T bitcoind bitcoin-cli -rpcport=43782 -rpcuser=polaruser -rpcpassword=polarpass getbalance)"
      awk -v balance="$balance" 'BEGIN { exit !(balance > 0) }' || {
        echo 'The pinned regtest wallet has no spendable balance.' >&2
        return 1
      }
      echo "Pinned backend ready with $balance BTC of spendable regtest funds."
      return
    fi
    sleep 2
  done

  echo 'Timed out waiting for Electrum and LND credentials.' >&2
  compose ps >&2
  return 1
}

case "${1:-}" in
  prepare) prepare ;;
  path)
    check_revision
    printf '%s\n' "$stack"
    ;;
  up) up ;;
  spark-pack)
    [[ "$#" -eq 2 && -n "$2" ]] || {
      echo 'Usage: ./scripts/local-backend spark-pack <image-archive>' >&2
      exit 2
    }
    spark_pack "$2"
    ;;
  spark-up) spark_up ;;
  spark-image-fingerprint)
    check_revision
    spark_image_fingerprint
    ;;
  spark-init-env) spark_init_env ;;
  spark-env) spark_env ;;
  spark-pay)
    check_revision
    [[ "${2:-}" =~ ^lnbcrt[a-z0-9]+$ && "$#" -eq 2 ]] || {
      echo 'Usage: ./scripts/local-backend spark-pay <regtest-invoice>' >&2
      exit 2
    }
    spark pay "$2"
    ;;
  spark-down)
    check_revision
    spark down
    ;;
  spark-logs)
    check_revision
    shift
    compose --profile spark logs "$@"
    ;;
  down|ps|logs)
    check_revision
    compose "$@"
    ;;
  github-env)
    check_revision
    set_runner_env
    for key in BITKIT_LOCAL_BACKEND_ROOT ELECTRUM_PORT LND_P2P_PORT LND_GRPC_PORT LND_REST_PORT LND_TLS_PATH LND_MACAROON_PATH; do
      printf '%s=%s\n' "$key" "${!key}"
    done
    ;;
  run)
    shift
    check_revision
    set_runner_env
    export BACKEND=local
    exec "$@"
    ;;
  *)
    echo 'Usage: ./scripts/local-backend {prepare|path|up|down|ps|logs|github-env|run <command>|spark-pack <image-archive>|spark-up|spark-image-fingerprint|spark-init-env|spark-env|spark-pay <invoice>|spark-down|spark-logs}' >&2
    exit 2
    ;;
esac
